<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Net.ViaTheFalcon.JnapUpMon.Remote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bluetooth="using:Net.ViaTheFalcon.JnapUpMon.Remote.Bluetooth"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Padding="24" RowSpacing="16"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   x:Uid="AppTitle"
                   Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- Device selector -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Uid="InstanceLabel"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="InstanceSelector"
                      x:Uid="InstanceSelector"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}" />
        </StackPanel>

        <!-- Read/notify characteristic: most recent reboot -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock x:Uid="MrrLabel"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBox IsReadOnly="True"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                     Text="{x:Bind ViewModel.MrrText, Mode=OneWay}" />
        </StackPanel>

        <!-- Read/notify characteristic: most recent run -->
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock x:Uid="MruLabel"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBox IsReadOnly="True"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                     Text="{x:Bind ViewModel.MruText, Mode=OneWay}" />
        </StackPanel>

        <!-- Writable characteristics: action buttons -->
        <StackPanel Grid.Row="4" Spacing="6">
            <TextBlock x:Uid="ActionsLabel"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="RunButton"
                        MinWidth="96"
                        Command="{x:Bind ViewModel.RunCommand}" />
                <Button x:Uid="RebootButton"
                        MinWidth="96"
                        Command="{x:Bind ViewModel.RebootCommand}" />
                <Button x:Uid="ResetButton"
                        MinWidth="96"
                        Command="{x:Bind ViewModel.ResetCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Status line -->
        <TextBlock Grid.Row="6"
                   VerticalAlignment="Bottom"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Window>
